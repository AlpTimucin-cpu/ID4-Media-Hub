# Android SDK / IDE / Gradle local state (never publish machine-specific paths)
/local.properties
**/local.properties
/.gradle/
**/.gradle/
**/build/
.idea/
*.iml
.externalNativeBuild/
.cxx/
captures/

# Built packages are published through reviewed CI / Releases, not Git
*.apk
*.aab
*.apks

# Private signing material, credential bundles and local secrets
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem
**/*.key
**/google-services.json
**/firebase-adminsdk*.json
**/service-account*.json
**/secrets.properties
**/apikeys.properties
EYA_GitHub_TEK_SECRET.txt
*signing*bundle*.txt
*keystore*secret*.txt
.env
.env.*
!.env.example

