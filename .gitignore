# Local Android SDK and Gradle state
/local.properties
/.gradle/
**/build/
*.apk
*.aab

# Never commit release keys, encoded key bundles, or developer credentials
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx
**/*.pem
**/*.key
EYA_GitHub_TEK_SECRET.txt
*signing*bundle*.txt
*keystore*secret*.txt
.env
.env.*
!.env.example

# Keep the verified Gradle Wrapper scripts and jar under version control
!gradle/wrapper/gradle-wrapper.jar
